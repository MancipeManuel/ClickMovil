<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ClickMovil" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.ClickMovil.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/teal</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/radius_button</item>
    </style>

    <style name="Widget.ClickMovil.Button.Navy" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/navy</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/radius_button</item>
    </style>

    <style name="Widget.ClickMovil.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/navy</item>
        <item name="android:textColor">@color/navy</item>
        <item name="cornerRadius">@dimen/radius_button</item>
    </style>

    <style name="Widget.ClickMovil.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/mint_2</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="Widget.ClickMovil.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/line</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_card</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_card</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_card</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_card</item>
        <item name="hintTextColor">@color/ink</item>
    </style>

    <style name="Theme.ClickMovil.Splash" parent="Theme.ClickMovil">
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
    </style>

    <style name="TextAppearance.ClickMovil.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">@dimen/text_title</item>
    </style>

    <style name="TextAppearance.ClickMovil.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>
</resources>
