<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy">

    <View
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-180dp"
        android:layout_marginBottom="-140dp"
        android:background="@drawable/bg_splash_arc" />

    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-90dp"
        android:layout_marginEnd="-110dp"
        android:background="@drawable/bg_splash_arc" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_logo"
                android:backgroundTint="@color/teal_2"
                android:elevation="4dp"
                android:gravity="center"
                android:text="CM"
                android:textColor="@color/navy"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/splash_tagline"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/splash_promise"
            android:textColor="@color/on_navy"
            android:textSize="16sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="@dimen/space_lg"
            android:text="@string/splash_version"
            android:textColor="@color/on_navy_muted"
            android:textSize="@dimen/text_small" />
    </LinearLayout>
</FrameLayout>
