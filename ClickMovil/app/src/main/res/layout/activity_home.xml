<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_sm">

        <ImageButton
            android:id="@+id/navBack"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/bg_header_logo"
            android:backgroundTint="@color/white_overlay_10"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:visibility="gone"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/brandMark"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/bg_header_logo"
            android:gravity="center"
            android:text="@string/brand_mark"
            android:textColor="@color/navy"
            android:textSize="@dimen/text_brand_sm"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/toolbarTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/text_toolbar"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/toolbarSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_navy"
                android:textSize="@dimen/text_small" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/cartShortcut"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/bg_header_logo"
            android:backgroundTint="@color/white_overlay_10"
            android:contentDescription="@string/cart"
            android:padding="10dp"
            android:src="@drawable/ic_cart"
            android:visibility="gone"
            app:tint="@color/white" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="@dimen/elevation_nav"
        app:itemActiveIndicatorStyle="@style/Widget.ClickMovil.NavIndicator"
        app:itemIconTint="@color/nav_item"
        app:itemPaddingBottom="10dp"
        app:itemPaddingTop="10dp"
        app:itemTextColor="@color/nav_item"
        app:labelVisibilityMode="labeled" />
</LinearLayout>
